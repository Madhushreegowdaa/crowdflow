{
  "name": "miniproject",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "cd server && npm install",
    "dev": "concurrently --kill-others --names frontend,ai,backend \"next dev\" \"python -m uvicorn main:app --app-dir ai-engine --reload --host 127.0.0.1 --port 8000\" \"npm --prefix server run dev\"",
    "build": "next build",
    "lint": "oxlint",
    "start": "next start",
    "test": "vitest run"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.64.0",
    "next": "16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/leaflet": "^1.9.22",
    "@types/node": "26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "oxlint": "^1.89.0",
    "tailwindcss": "^4",
    "typescript": "7.0.2",
    "vitest": "^5.1.1"
  }
}
